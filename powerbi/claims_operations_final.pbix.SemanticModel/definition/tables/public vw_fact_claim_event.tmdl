table 'public vw_fact_claim_event'
	lineageTag: b3faf8b7-d2b7-4433-b446-bf975c158c0b

	measure 'Completed Stage Events' =
			
			COUNTROWS(FILTER('public vw_fact_claim_event', NOT ISBLANK('public vw_fact_claim_event'[exited_at])))
		formatString: 0
		lineageTag: 00612e4a-4b4d-4e1d-8c87-77695542b3d1

	measure 'Completed SLA Breaches' =
			
			COUNTROWS(FILTER('public vw_fact_claim_event', NOT ISBLANK('public vw_fact_claim_event'[exited_at]) && DATEDIFF('public vw_fact_claim_event'[entered_at], 'public vw_fact_claim_event'[exited_at], MINUTE) > 'public vw_fact_claim_event'[allowed_hours] * 60))
		formatString: 0
		lineageTag: 7830bfa7-585b-4b69-8e50-3571d3c42721

	measure 'Completed Stage SLA Breach Rate' =
			
			DIVIDE([Completed SLA Breaches], [Completed Stage Events], 0)
		formatString: 0.00%
		lineageTag: 183431ea-0094-42dd-ac2a-ca0f89da56fe

	measure 'Average Completed Stage Hours' =
			
			AVERAGEX(FILTER('public vw_fact_claim_event', NOT ISBLANK('public vw_fact_claim_event'[exited_at])), DATEDIFF('public vw_fact_claim_event'[entered_at], 'public vw_fact_claim_event'[exited_at], MINUTE)/60.0)
		formatString: 0.00
		lineageTag: 6075f4cf-678f-4620-9364-1959d4f7387b

	measure 'Event Count' =
			
			DISTINCTCOUNT('public vw_fact_claim_event'[event_id])
		formatString: 0
		lineageTag: 480311c2-231b-4c42-aa3f-9643cb76a38d

