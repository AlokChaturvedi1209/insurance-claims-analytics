table 'public vw_fact_claim'
	lineageTag: 4d34cbae-63d8-41b1-9e63-831981d9eef4

	measure 'Total Claims' =
			
			DISTINCTCOUNT('public vw_fact_claim'[claim_id])
		formatString: 0
		lineageTag: e10a749d-a074-441b-b9de-16ce06a0fb28

	measure 'Approved Claims' =
			
			CALCULATE(
			    [Total Claims],
			    'public vw_fact_claim'[current_status] = "Approved"
			)
		formatString: 0
		lineageTag: 19776719-7fc8-41b3-a161-3172b37daaff

	measure 'Open Claims' =
			
			CALCULATE(
			    [Total Claims],
			    'public vw_fact_claim'[current_status] IN {"Pending", "In Review"}
			)
		formatString: 0
		lineageTag: 6b4444cb-47c9-4106-acbf-1c350fb95f2b

	measure 'Closed Approval Rate' =
			
			DIVIDE(
			    [Approved Claims],
			    CALCULATE(
			        [Total Claims],
			        'public vw_fact_claim'[current_status] IN {"Approved", "Rejected"}
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c985eb5d-6cfa-4e4b-86aa-3eb9636c2e44

	measure 'Rejected Claims' =
			
			CALCULATE([Total Claims], 'public vw_fact_claim'[current_status] = "Rejected")
		formatString: 0
		lineageTag: 7ae8f6d8-9fc9-4946-a5ab-827a650c570f

	measure 'Average Closed Turnaround Hours' =
			
			AVERAGEX(FILTER('public vw_fact_claim', 'public vw_fact_claim'[current_status] IN {"Approved", "Rejected"} && NOT ISBLANK('public vw_fact_claim'[closed_at])), DATEDIFF('public vw_fact_claim'[submitted_at], 'public vw_fact_claim'[closed_at], MINUTE) / 60.0)
		formatString: 0.00
		lineageTag: 3a1c406f-5832-423a-9061-27a4a6c36cd7

	measure 'Open Claims Over 72 Hours' =
			
			CALCULATE(DISTINCTCOUNT('public vw_fact_claim'[claim_id]), FILTER('public vw_fact_claim', 'public vw_fact_claim'[current_status] IN {"Pending", "In Review"} && DATEDIFF('public vw_fact_claim'[submitted_at], DATE(2026,10,31)+TIME(23,59,59), HOUR) > 72))
		formatString: 0
		lineageTag: e25158c6-a2be-4085-8d7d-8e9b3d4eff83

	measure 'Closed Claims' =
			
			CALCULATE([Total Claims], 'public vw_fact_claim'[current_status] IN {"Approved", "Rejected"})
		formatString: 0
		lineageTag: bef9fef3-e08c-4f73-b4a8-9bd580ca94ef

	measure 'Rejection Rate' =
			
			DIVIDE([Rejected Claims], [Closed Claims], 0)
		formatString: 0.00%
		lineageTag: 249d0243-9aad-40b1-a70a-f3289333bf3d

